# ---------------------------------------------------------------
# StaySync API - example environment. Copy to .env and edit.
# PLACEHOLDERS ONLY. Never commit real secrets.
# ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=StaySync
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# PostgreSQL (matches infra/docker-compose.yml / infra/.env)
# The API connects as the least-privilege role staysync_app (row-level security applies).
DATABASE_URL=postgresql://staysync_app:change-me-app-password@localhost:5432/staysync?schema=public
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql://staysync:change-me-local-only@localhost:5432/staysync?schema=public
# Separate database used only by integration tests (data is created and modified by tests)
TEST_DATABASE_URL=postgresql://staysync_app:change-me-app-password@localhost:5432/staysync_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://staysync:change-me-local-only@localhost:5432/staysync_test?schema=public

# Public URL of the web app (used in email links)
APP_BASE_URL=http://localhost:4200

# Comma-separated list of browser origins allowed to call the API with credentials.
# Never use "*".
CORS_ORIGINS=http://localhost:4200

# Reverse proxy trust. "false" when the API is reached directly (local dev).
# Behind exactly one proxy use 1; or a comma list of proxy IPs/CIDRs, e.g. 10.0.0.0/8.
TRUST_PROXY=false

# Max JSON body size
BODY_LIMIT=100kb

# Swagger UI at /api/docs. Unset = on in development, off in production.
# API_DOCS_ENABLED=false

# ---------------- Authentication & security -------------------------------
# 32 random bytes, base64. Encrypts TOTP secrets and keys recovery-code hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates all enrolled authenticator apps. Keep it in a secrets manager in production.
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=720
# Cookies are Secure automatically in production; leave unset for http://localhost.
# COOKIE_SECURE=true
STEP_UP_WINDOW_MINUTES=10
# 2FA for organization owners: optional | required (platform admins always require 2FA;
# each organization can also require it for all members)
OWNER_2FA_POLICY=optional
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=900
AUTH_FAILURE_WINDOW_MINUTES=15
NOTIFY_SUSPICIOUS_ACTIVITY=true

# ---------------- Email (Mailpit in development: http://localhost:8025) ------
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StaySync <no-reply@staysync.local>

# ---------------- Zodomus channel manager (server-side only) ---------------
ZODOMUS_ENABLED=false
ZODOMUS_ENVIRONMENT=sandbox
ZODOMUS_BASE_URL=https://api.zodomus.com
ZODOMUS_API_USERNAME=
ZODOMUS_API_PASSWORD=
ZODOMUS_TIMEOUT_MS=15000
# Production inventory changes need an explicit opt-in (sandbox writes are always allowed when enabled).
ZODOMUS_ALLOW_PRODUCTION_WRITES=false

# ---------------- Channel sync worker ----------------------------------------
# Sends queued availability/rate updates in the background (default: on, except in tests).
# SYNC_WORKER_ENABLED=true
SYNC_WORKER_INTERVAL_MS=5000
# How far ahead a full sync sends availability and rates (channels recommend one year).
SYNC_HORIZON_DAYS=365
