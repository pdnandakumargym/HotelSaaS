# StaySync production settings for infra/docker-compose.prod.yml.
# Copy to infra/.env.production, fill in every value, keep the file only on the server (never in Git or chat).

# Public DNS name of the app (A/AAAA record → this server). Caddy gets the HTTPS certificate for it.
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Database passwords: generate long random values, e.g.  openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_DB=staysync

# 32-byte key for TOTP secrets and guest-data encryption:  openssl rand -base64 32
# Back it up safely. Losing it makes encrypted guest details and 2FA secrets unreadable.
DATA_ENCRYPTION_KEY=

# Outgoing email (verification, password reset, invitations)
MAIL_FROM=StaySync <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Every owner must use two-factor authentication
OWNER_2FA_POLICY=required

# Zodomus (production keys from the Zodomus backoffice → Development, after certification)
ZODOMUS_ENABLED=false
ZODOMUS_ENVIRONMENT=production
ZODOMUS_API_USERNAME=
ZODOMUS_API_PASSWORD=
# Must be true before StaySync may change real Booking.com availability and rates
ZODOMUS_ALLOW_PRODUCTION_WRITES=false

# Beds24 (optional second channel manager; see docs/beds24-api.md). Live account: no sandbox.
BEDS24_ENABLED=false
BEDS24_REFRESH_TOKEN=
BEDS24_ALLOW_WRITES=false
# true/false as reported by `npm run beds24:check`; calendar writes are refused while empty
BEDS24_CALENDAR_TO_INCLUSIVE=
RESERVATION_POLL_INTERVAL_MS=60000

# Erase guest personal data N days after check-out (0 = keep; check local guest-register laws first)
GUEST_DATA_RETENTION_DAYS=0

BACKUP_KEEP_DAYS=14
LOG_LEVEL=info
