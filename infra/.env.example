# Docker Compose settings for local services. Copy to infra/.env.
# scripts/setup-windows.ps1 creates infra/.env with a random password automatically.
POSTGRES_USER=staysync
POSTGRES_PASSWORD=change-me-local-only
# Least-privilege role used by the API (row-level security applies to it)
APP_DB_PASSWORD=change-me-app-password
POSTGRES_DB=staysync
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
